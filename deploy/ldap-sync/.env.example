# Copy to .env and fill in host paths. .env is consumed by Docker Compose for
# both container environment and volume interpolation. Keep it mode 600.

# --- host paths (Docker Compose only; not visible to the container as such) ---
LDAP_PASSWORD_FILE_HOST=/home/pricetag/.ldap_key
LDAP_CA_CERT_HOST=/home/pricetag/enmaas-ldap/2022-IT-Root-CA.pem
DATABASE_URL_FILE_HOST=/home/pricetag/.config/pricetag/database-url
LDAP_SYNC_OUTPUT_DIR_HOST=/var/lib/pricetag-ldap-sync

# --- container paths (sync script inputs) ---
LDAP_PASSWORD_FILE=/run/secrets/ldap_key
LDAP_CA_CERT=/run/secrets/ldap_ca.pem
DATABASE_URL_FILE=/run/secrets/database_url
LDAP_SYNC_OUTPUT_DIR=/var/lib/ldap-sync

# --- schedule and behavior ---
# 86400 = once every 24 hours. Minimum accepted value is 60 seconds.
LDAP_SYNC_INTERVAL_SECONDS=86400
LDAP_SYNC_RUN_ON_START=1
LDAP_SYNC_APPLY=1
# "directory" = org/manager/status/display fields. Use "all" only if you
# deliberately want the opt-in email/kerberos fields too.
LDAP_SYNC_FIELDS=directory
# Production currently has ~3,348 matched users. Keep this comfortably below
# that number so a broken LDAP search cannot wipe fields from a partial result.
LDAP_SYNC_MIN_MATCHED=3000

# Optional LDAP overrides. Defaults are the production IPA failover list and
# the standard user base/filter.
#LDAP_USER_BASE=cn=users,cn=accounts,dc=ipa,dc=redhat,dc=com
#LDAP_FILTER=(&(objectClass=posixAccount)(rhatUUID=*))

# Optional: set for verbose troubleshooting on a one-off run; leave unset in
# normal service operation.
#LDAP_DEBUG=1
